# Copy to .env on the SERVER only. Never commit .env.
CT_ENV=production
CT_PUBLIC_BASE_URL=https://terminal.example.com
CT_DATABASE_URL=postgresql+psycopg://ct:CHANGE_ME@db:5432/ct
POSTGRES_PASSWORD=CHANGE_ME

# Generate the next four with:  python scripts/make_secrets.py
CT_PASSWORD_HASH=
CT_TOTP_SECRET=
CT_SESSION_SECRET=
CT_TOKEN_ENCRYPTION_KEY=

# From https://developers.kite.trade (your Kite Connect app)
CT_KITE_API_KEY=
CT_KITE_API_SECRET=

# Domain Caddy should get an HTTPS certificate for
CT_DOMAIN=terminal.example.com
